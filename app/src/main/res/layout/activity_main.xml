<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="99 Nights Survival"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/tvPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jugador:" />

    <TextView
        android:id="@+id/tvHealth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vida: 100" />

    <TextView
        android:id="@+id/tvNight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Noche: 1" />

    <TextView
        android:id="@+id/tvFire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fuego: 50" />

    <TextView
        android:id="@+id/tvWood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Madera: 0" />

    <TextView
        android:id="@+id/tvFood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comida: 2" />

    <Button
        android:id="@+id/btnCollectWood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recoger madera" />

    <Button
        android:id="@+id/btnAddWoodToFire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Echar madera al fuego" />

    <Button
        android:id="@+id/btnEat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comer" />

    <Button
        android:id="@+id/btnNextNight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Siguiente noche" />

    <TextView
        android:id="@+id/tvGameOver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GAME OVER"
        android:textSize="24sp"
        android:visibility="gone" />

</LinearLayout>